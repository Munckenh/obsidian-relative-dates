{
	"name": "obsidian-relative-dates",
	"version": "1.5.1",
	"description": "Relative, color-coded dates for Obsidian",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json package.json package-lock.json && git commit -m \"chore: $npm_package_version\" && git tag $npm_package_version -m \"\"",
		"lint": "eslint ."
	},
	"keywords": [
		"obsidian",
		"plugin",
		"date",
		"relative"
	],
	"author": "Munckenh",
	"license": "MIT",
	"devDependencies": {
		"@codemirror/language": "6.11.2",
		"@codemirror/state": "6.5.0",
		"@codemirror/view": "6.38.6",
		"@types/node": "^22.19.19",
		"esbuild": "^0.28.2",
		"eslint": "^9.39.4",
		"eslint-plugin-obsidianmd": "^0.4.2",
		"globals": "^17.13.0",
		"obsidian": "~1.13.0",
		"obsidian-daily-notes-interface": "^0.9.5",
		"tslib": "^2.8.1",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.71.1"
	}
}
